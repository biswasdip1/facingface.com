# Reference only. Preserve the existing production values in Render.
# Never commit real secrets to Git or include them in a deployment ZIP.
NODE_ENV=production
PORT=3000
DATABASE_URL=
JWT_SECRET=
# If CHAT_ENCRYPTION_KEY is already configured, preserve it exactly.
CHAT_ENCRYPTION_KEY=
PUBLIC_APP_URL=https://www.facingface.com
RUN_DATABASE_MIGRATIONS_ON_STARTUP=false

# Existing persistent disk must remain attached at /var/data.
MEDIA_STORAGE_DRIVER=disk
MEDIA_STORAGE_PATH=/var/data/media
MEDIA_PUBLIC_PATH=/media

# Production email is required for email verification/recovery and passwordless deletion codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional browser-only digital-plan payments. Native release is free.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Preserve any existing payment price/product variables from your current service.

# Optional web push and TURN settings: preserve all existing configured values.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# See current server configuration for the TURN provider variables you already use.

# Administrator creation is OFF by default. Existing admin accounts are untouched.
SEED_ADMIN_ENABLED=false
# To seed a brand-new empty deployment deliberately, set explicit email/name and
# a unique 16+ character SEED_ADMIN_PASSWORD once, then disable/remove these settings.
